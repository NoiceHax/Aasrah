# --- Database (Neon Postgres) ---
# Dedicated var (preferred); overrides any generic DATABASE_URL in the shell.
AASRAH_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- App ---
# ENVIRONMENT gates every security-relevant behaviour (HSTS, /docs exposure,
# whether the password-reset token is echoed in the response). Set it to
# `production` on any public deploy.
ENVIRONMENT=development
# DEBUG only raises log verbosity. It must never gate a security decision.
DEBUG=true
PROJECT_NAME=Aasrah API
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Security ---
SECRET_KEY=generate-with-secrets-token_urlsafe-48
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGES_PER_REPORT=6

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_AUTH=10/minute

# --- External services ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=AasrahHumanitarianPlatform/1.0

# --- AI (NVIDIA NIM, OpenAI-compatible). Leave key empty for heuristic fallback. ---
NVIDIA_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
AI_TEXT_MODEL=openai/gpt-oss-120b
# Third-party VISION analysis of report photographs. OFF by default, and needs
# NVIDIA_API_KEY as well as this flag to run.
#
# Enabling it uploads photographs of identifiable people -- who are reported
# *about*, not by, and may be children -- to an external processor, which is
# asked to infer their age band and gender. Before you turn this on you need a
# lawful basis for that processing, a data-processing agreement with the
# provider, and a matching disclosure in your privacy notice. With it off,
# analysis falls back to a local text-only heuristic and nothing leaves the
# server. Text summarisation is unaffected by this flag.
AI_VISION_ENABLED=false

# --- Email (SMTP). Leave host empty to log email previews instead of sending. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Aasrah <no-reply@aasrah.org>
SMTP_USE_TLS=true

# --- Web Push (VAPID). Generate with: python -m scripts.gen_vapid ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@aasrah.org

# --- Background workers ---
RUN_BACKGROUND_WORKERS=true
AUTOMATION_INTERVAL_SECONDS=300

# --- Error tracking (Sentry). Dormant unless a DSN is set. ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
